  "clauses": [
    {
      "id": "EU-CLP/Art17-1a",
      "section": "Legal & Identity",
      "text": "The name, address and telephone number of the supplier are shown.",
      "keywords": [
        "supplier",
        "address",
        "telephone"
      ],
      "source": {
        "name": "EU Regulation (EC) 1272/2008 (CLP), Art. 17",
