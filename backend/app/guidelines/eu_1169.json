    },
    {
      "id": "EU-1169/Art21",
      "section": "Ingredients & Allergens",
      "text": "Allergens listed in Annex II must be emphasised in the ingredient list, for example in bold (Art. 21).",
      "keywords": [
        "allergen",
        "annex ii",
        "cereals containing gluten"
      ],
      "requires": [
