# BriefForge settings. Copy this file to ".env" (same folder) and fill in what you use.
# Everything is optional: with LLM_PROVIDER=none the whole pipeline runs on code only.
#
# AI roles (each can use a different model/provider):
#   vision     reads the rendered artwork and compares it with the file text   (needs an IMAGE-capable model)
#   ocr        reads text from images/scans when Tesseract is not installed    (needs an IMAGE-capable model)
#   rules      checks the brief against the market's label clauses             (text model, strong reasoning)
#   claims     second opinion on claims and wording                            (text model)
#   questions  rewrites questions in plain language for each owner             (small, fast text model)
#   chat       answers questions about the brief                               (small, fast text model)
# A role with no settings of its own uses the shared LLM_* values below.
# A role that sets its own LLM_<ROLE>_PROVIDER does NOT inherit the shared key, so give it its own key.

# ---------------------------------------------------------------- shared default
# none | gemini | openai_compatible
# Shared model = Gemini (https://aistudio.google.com/apikey). Used by the image roles: vision and ocr.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Only for openai_compatible (Groq, OpenRouter, Ollama, OpenAI ...)
LLM_BASE_URL=
LLM_TIMEOUT_S=90
# Max reply length; reasoning models need room to think and then answer
LLM_MAX_TOKENS=4096

# ---------------------------------------------------------------- text roles on Groq
# vision and ocr use the Gemini settings above. These four text roles use Groq (fast, free tier).
# Paste the SAME Groq key (https://console.groq.com/keys) into all four API_KEY lines.
# MODELS below were available on a free Groq key; if one 404s, pick a text model from the Groq console.
LLM_RULES_PROVIDER=openai_compatible
LLM_RULES_BASE_URL=https://api.groq.com/openai/v1
LLM_RULES_API_KEY=
LLM_RULES_MODEL=openai/gpt-oss-120b

LLM_CLAIMS_PROVIDER=openai_compatible
LLM_CLAIMS_BASE_URL=https://api.groq.com/openai/v1
LLM_CLAIMS_API_KEY=
LLM_CLAIMS_MODEL=openai/gpt-oss-20b

LLM_QUESTIONS_PROVIDER=openai_compatible
LLM_QUESTIONS_BASE_URL=https://api.groq.com/openai/v1
LLM_QUESTIONS_API_KEY=
LLM_QUESTIONS_MODEL=openai/gpt-oss-20b

LLM_CHAT_PROVIDER=openai_compatible
LLM_CHAT_BASE_URL=https://api.groq.com/openai/v1
LLM_CHAT_API_KEY=
LLM_CHAT_MODEL=openai/gpt-oss-20b

# ---------------------------------------------------------------- OCR (images and scanned PDF pages)
# auto      Tesseract if installed, else the 'ocr' vision model, else nothing
# tesseract local only (free, offline, gives a box and confidence per line)
# llm       the 'ocr' vision model only
# none      do not OCR
OCR_ENGINE=auto
# Windows example: C:/Program Files/Tesseract-OCR/tesseract.exe   (leave blank if "tesseract" is on PATH)
TESSERACT_CMD=
# Tesseract language codes, e.g. eng, eng+fra, eng+deu
OCR_LANG=eng
# Text read below this confidence (0-1) is flagged for a human check
OCR_MIN_CONFIDENCE=0.6

# ---------------------------------------------------------------- storage and web
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RENDER_DPI=144

# ================================================================ free options that suit each role
# Free tiers and model names change often. Check each console for the current limits and model list.
#
# Google AI Studio (provider: gemini)      https://aistudio.google.com/apikey
#   Free key, no card. Reads images well. Best for: vision, ocr.
#   LLM_VISION_PROVIDER=gemini  LLM_VISION_API_KEY=<key>  LLM_VISION_MODEL=gemini-3.8-flash
#   Note: older models (e.g. gemini-2.5-flash) may be closed to new keys.
#
# Groq (provider: openai_compatible)       https://console.groq.com/keys
#   Free tier, very fast. Best for: rules, claims, questions, chat.
#   LLM_RULES_PROVIDER=openai_compatible  LLM_RULES_BASE_URL=https://api.groq.com/openai/v1
#   LLM_RULES_API_KEY=<key>               LLM_RULES_MODEL=<a Llama or other text model listed in the Groq console>
#   Groq also lists a vision-capable Llama 4 model if you want one key for everything.
#
# OpenRouter (provider: openai_compatible) https://openrouter.ai/keys
#   One key, many models. Models whose id ends in ":free" cost nothing but are rate limited. Good as a spare.
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#
# Ollama (provider: openai_compatible)     https://ollama.com
#   Runs on your machine: no key, no limits, works offline (a good fallback for the demo).
#   LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=<a model you pulled, e.g. a Llama or Qwen build>
#   For vision/ocr pull an image-capable model.
#
# Tesseract (not an LLM)                   https://github.com/UB-Mannheim/tesseract/wiki  (Windows installer)
#   Free local OCR. Install it, then set TESSERACT_CMD if it is not on PATH. No API key needed.
