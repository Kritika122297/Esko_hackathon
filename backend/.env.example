# AI provider: none | gemini | openai_compatible
# "none" runs everything with deterministic code (no AI vision cross-check).
LLM_PROVIDER=none
LLM_API_KEY=
# Examples:
#   gemini:            LLM_MODEL=gemini-3.8-flash   (gemini-2.5-flash is closed to new keys)
#   openai_compatible: LLM_BASE_URL=https://api.groq.com/openai/v1
#                      LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
LLM_MODEL=
LLM_BASE_URL=

UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
